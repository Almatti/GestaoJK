# ===== Frontend (Vite) — somente valores PÚBLICOS =====
# URL do projeto Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# Chave pública (anon/publishable). NUNCA coloque a service_role key aqui.
VITE_SUPABASE_ANON_KEY=sua-chave-publica
# auto (padrão) | demo  → "demo" força o ambiente de demonstração com dados fictícios no navegador
VITE_APP_MODE=auto

# ===== Edge Functions (configure com: supabase secrets set NOME=valor) — NÃO usar no frontend =====
# APP_ORIGIN=https://gestao.jkchopp.com.br
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_STATE_SECRET=gere-um-valor-aleatorio-longo
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# AI_DAILY_LIMIT=30

# ===== Scripts de backup (apenas na máquina de quem executa) =====
# SUPABASE_DB_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres
